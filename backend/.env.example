GCP_PROJECT_ID=demo-project
GCP_REGION=us-central1
USE_MOCK_AI=true
# Restricted GCP API key (scoped to generativelanguage.googleapis.com +
# translate.googleapis.com only) used for direct REST calls to Gemini and
# Cloud Translation. If unset, falls back to Application Default Credentials
# via Vertex AI. In production this is injected from Secret Manager
# (see backend/cloudbuild.yaml / Cloud Run --set-secrets), never hardcoded.
GENAI_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@recoveryhub.example.com
JWT_SECRET=change-me

# Comma-separated list of allowed frontend origins for CORS (spec.md Section 4.4 Security).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true to require the X-User-Id header on RBAC-protected endpoints (see app/auth.py).
REQUIRE_AUTH=false

# Live-demo mode: set to false to start with real user accounts but ZERO
# pre-written profiles/crisis events, so every artifact shown during judging
# is generated live (spec.md Section 4.9).
SEED_DEMO_DATA=true
